<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestionDevoluciones.Views.DetalleDevolucionPage"
             BackgroundColor="#121212"
             Title="Revisión">

    <Frame BackgroundColor="#1E1E1E" BorderColor="#333333" CornerRadius="16" Padding="25" Margin="20" VerticalOptions="Center">
        <VerticalStackLayout Spacing="15">
            <Label Text="Revisar y Editar" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" Margin="0,0,0,10"/>
            
            <Label Text="Cliente:" TextColor="#888888" FontSize="12" Margin="0,5,0,-10"/>
            <Entry Text="{Binding NombreCliente}" TextColor="White" BackgroundColor="#2D2D2D"/>

            <!-- Contacto y Fecha en dos columnas para ahorrar espacio visual -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,-5,0,0">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Contacto:" TextColor="#888888" FontSize="12" Margin="0,0,0,5"/>
                    <Entry Text="{Binding Contacto}" TextColor="White" BackgroundColor="#2D2D2D"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Fecha de Ingreso:" TextColor="#888888" FontSize="12" Margin="0,0,0,5"/>
                    <!-- IsReadOnly="True" evita que el usuario rompa el formato de la fecha al tipear -->
                    <Entry Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}" TextColor="#CCCCCC" BackgroundColor="#2D2D2D" IsReadOnly="True"/>
                </VerticalStackLayout>
            </Grid>

            <Label Text="Producto a devolver:" TextColor="#888888" FontSize="12" Margin="0,5,0,-10"/>
            <Entry Text="{Binding NombreProducto}" TextColor="White" BackgroundColor="#2D2D2D"/>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,-5,0,0">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Marca:" TextColor="#888888" FontSize="12" Margin="0,0,0,5"/>
                    <Entry Text="{Binding MarcaProducto}" TextColor="White" BackgroundColor="#2D2D2D"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Modelo:" TextColor="#888888" FontSize="12" Margin="0,0,0,5"/>
                    <Entry Text="{Binding ModeloProducto}" TextColor="White" BackgroundColor="#2D2D2D"/>
                </VerticalStackLayout>
            </Grid>

            <Label Text="Motivo:" TextColor="#888888" FontSize="12" Margin="0,5,0,-10"/>
            <Entry Text="{Binding Motivo}" TextColor="White" BackgroundColor="#2D2D2D"/>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,20,0,0">
                <Button Grid.Column="0" Text="Cancelar" Clicked="OnCancelarClicked" BackgroundColor="#333333" TextColor="White" CornerRadius="8"/>
                <Button Grid.Column="1" Text="✔ Confirmar" Clicked="OnConfirmarClicked" BackgroundColor="#00C853" TextColor="White" FontAttributes="Bold" CornerRadius="8"/>
            </Grid>
        </VerticalStackLayout>
    </Frame>
</ContentPage>