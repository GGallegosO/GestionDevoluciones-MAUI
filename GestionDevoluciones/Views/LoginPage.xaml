<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GestionDevoluciones.ViewModels"
             x:Class="GestionDevoluciones.Views.LoginPage"
             Title="GestionDevoluciones"
             BackgroundColor="#121212"> <ContentPage.BindingContext>
        <viewmodels:LoginViewModel />
    </ContentPage.BindingContext>

    <Grid Padding="20">
        
        <Frame BackgroundColor="#1E1E1E" 
               BorderColor="#333333" 
               CornerRadius="16" 
               Padding="30"
               HasShadow="True"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               WidthRequest="320"> <VerticalStackLayout Spacing="15">
                
                <Label Text="INICIAR SESIÓN" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       TextColor="#FFFFFF" 
                       HorizontalOptions="Center"
                       Margin="0,0,0,10"/>

                <Frame BackgroundColor="#2D2D2D" 
                       BorderColor="#333333" 
                       CornerRadius="8" 
                       Padding="10,0" 
                       HasShadow="False">
                    <Entry Placeholder="Username" 
                           Text="{Binding UsernameInput}" 
                           TextColor="White"
                           PlaceholderColor="#888888"
                           HeightRequest="40"/>
                </Frame>
                
                <Frame BackgroundColor="#2D2D2D" 
                       BorderColor="#333333" 
                       CornerRadius="8" 
                       Padding="10,0" 
                       HasShadow="False">
                    <Entry Placeholder="Password" 
                           Text="{Binding PasswordInput}" 
                           IsPassword="True" 
                           TextColor="White"
                           PlaceholderColor="#888888"
                           HeightRequest="40"/>
                </Frame>

                <Label Text="{Binding MensajeError}" 
                       TextColor="#FF5252" 
                       HorizontalOptions="Center" 
                       FontSize="12"/>

                <Button Text="ENTRAR" 
                        Command="{Binding LoginCommand}" 
                        BackgroundColor="#512BD4"
                        TextColor="White"
                        CornerRadius="8"
                        FontAttributes="Bold"
                        HeightRequest="45"
                        Margin="0,15,0,0"/>
                        
                <Label Text="¿Olvidó su contraseña?" 
                       TextColor="#888888" 
                       FontSize="12" 
                       HorizontalOptions="Center"
                       Margin="0,10,0,0"/>

            </VerticalStackLayout>
        </Frame>

    </Grid>

</ContentPage>